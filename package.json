{
  "name": "agent-rules-manager",
  "displayName": "Agent Rules Manager",
  "description": "Manage, compare, and sync AI agent rule files across Cursor, Windsurf, Kiro, Antigravity, Augment, and Claude Code formats.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "christoffer-lonnerfors",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/christoffer-lonnerfors/agent-rules-manager"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "ai",
    "rules",
    "agent",
    "ai-rules",
    "ai-agent",
    "cursor",
    "windsurf",
    "kiro",
    "antigravity",
    "augment",
    "claude",
    "claude-code",
    "cursorrules",
    "windsurfrules",
    "AGENTS.md",
    "CLAUDE.md",
    "mdc",
    "lint",
    "linter",
    "sync",
    "coverage",
    "tokens",
    "context-window",
    "copilot",
    "coding-agent",
    "frontmatter",
    "divergence"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "agent-rules-manager",
        "label": "Agent Rules Manager"
      }
    ],
    "commands": [
      {
        "command": "agentRules.rescan",
        "title": "Agent Rules: Refresh Rules",
        "icon": "$(refresh)"
      },
      {
        "command": "agentRules.openRule",
        "title": "Agent Rules: Open Rule File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agentRules.compareFormats",
        "title": "Compare Formats…",
        "icon": "$(diff)"
      },
      {
        "command": "agentRules.alignFormats",
        "title": "Align Formats…",
        "icon": "$(sync)"
      },
      {
        "command": "agentRules.setAgent",
        "title": "Agent Rules: Select Agent",
        "icon": "$(edit)"
      },
      {
        "command": "agentRules.syncAll",
        "title": "Agent Rules: Sync All Diverged",
        "icon": "$(sync)"
      },
      {
        "command": "agentRules.addAllMissing",
        "title": "Agent Rules: Add All Missing",
        "icon": "$(add)"
      },
      {
        "command": "agentRules.addMissingRule",
        "title": "Add Missing Rule",
        "icon": "$(add)"
      },
      {
        "command": "agentRules.addRule",
        "title": "Agent Rules: Add Rule",
        "icon": "$(new-file)"
      },
      {
        "command": "agentRules.showCoverage",
        "title": "Agent Rules: Show Coverage Analysis",
        "icon": "$(graph)"
      },
      {
        "command": "agentRules.filterRules",
        "title": "Agent Rules: Filter Rules",
        "icon": "$(search)"
      },
      {
        "command": "agentRules.clearFilter",
        "title": "Agent Rules: Clear Filter",
        "icon": "$(close)"
      },
      {
        "command": "agentRules.showLogicalView",
        "title": "Agent Rules: Switch to Logical View",
        "icon": "$(list-unordered)"
      },
      {
        "command": "agentRules.showFileTreeView",
        "title": "Agent Rules: Switch to File Tree View",
        "icon": "$(list-tree)"
      },
      {
        "command": "agentRules.deleteRuleFile",
        "title": "Delete File…",
        "icon": "$(trash)"
      },
      {
        "command": "agentRules.deleteAllRuleFormatFiles",
        "title": "Delete All Format Files…",
        "icon": "$(trash)"
      },
      {
        "command": "agentRules.installMetaRule",
        "title": "Agent Rules: Install Rule-Writing Guidelines",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agentRules.exportCoverage",
        "title": "Agent Rules: Export Coverage Report",
        "icon": "$(export)"
      },
      {
        "command": "agentRules.exportCoverageDefault",
        "title": "Agent Rules: Export Coverage Report (Default Path)"
      },
      {
        "command": "agentRules.configureMcpForClaude",
        "title": "Agent Rules: Configure MCP for Claude Code (stdio)",
        "icon": "$(plug)"
      },
      {
        "command": "agentRules.getStarted",
        "title": "Agent Rules: Get Started"
      }
    ],
    "languageModelTools": [
      {
        "name": "agentRulesManager_analyzeCoverage",
        "toolReferenceName": "analyzeRulesCoverage",
        "displayName": "Analyze Agent Rules Coverage",
        "modelDescription": "Returns a JSON report of which AI agent rules apply to each workspace file, with token cost estimates. Use this to identify over-tokenized files and plan rule optimizations. Accepts optional agentId to filter by agent.",
        "description": "Returns a JSON report of which AI agent rules apply to each workspace file, with token cost estimates. Use this to identify over-tokenized files and plan rule optimizations. Accepts optional agentId to filter by agent.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "agentId": {
              "type": "string",
              "description": "Optional: filter coverage by agent. Valid values: 'cursor', 'windsurf', 'kiro', 'antigravity', 'augment', 'claude-code'. Omit to analyze all agents."
            }
          }
        },
        "tags": [
          "agent-rules",
          "coverage",
          "tokens"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentRules",
          "title": "Agent Rules",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "agentRules": [
        {
          "id": "agentRules.rulesView",
          "name": "Rules",
          "icon": "$(list-unordered)",
          "contextualTitle": "Agent Rules"
        },
        {
          "id": "agentRules.actionsView",
          "type": "webview",
          "name": "Actions",
          "icon": "$(tools)",
          "contextualTitle": "Agent Rules"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentRules.rulesView",
        "contents": "No rules yet.\n[Add a rule](command:agentRules.addRule)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentRules.addRule",
          "when": "view == agentRules.rulesView",
          "group": "navigation@1"
        },
        {
          "command": "agentRules.filterRules",
          "when": "view == agentRules.rulesView",
          "group": "navigation@2"
        },
        {
          "command": "agentRules.showFileTreeView",
          "when": "view == agentRules.rulesView && agentRules.viewMode == logical",
          "group": "navigation@5"
        },
        {
          "command": "agentRules.showLogicalView",
          "when": "view == agentRules.rulesView && agentRules.viewMode == fileTree",
          "group": "navigation@5"
        },
        {
          "command": "agentRules.rescan",
          "when": "view == agentRules.rulesView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "agentRules.compareFormats",
          "when": "view == agentRules.rulesView && viewItem =~ /logicalRule.*diverged/",
          "group": "inline"
        },
        {
          "command": "agentRules.alignFormats",
          "when": "view == agentRules.rulesView && viewItem =~ /logicalRule.*diverged/",
          "group": "inline"
        },
        {
          "command": "agentRules.compareFormats",
          "when": "view == agentRules.rulesView && viewItem =~ /logicalRule.*diverged/",
          "group": "1_compare"
        },
        {
          "command": "agentRules.alignFormats",
          "when": "view == agentRules.rulesView && viewItem =~ /logicalRule.*diverged/",
          "group": "2_align"
        },
        {
          "command": "agentRules.addMissingRule",
          "when": "view == agentRules.rulesView && viewItem =~ /logicalRule.*missing/",
          "group": "inline"
        },
        {
          "command": "agentRules.addMissingRule",
          "when": "view == agentRules.rulesView && viewItem =~ /logicalRule.*missing/",
          "group": "1_add"
        },
        {
          "command": "agentRules.deleteRuleFile",
          "when": "view == agentRules.rulesView && viewItem =~ /ruleFile/",
          "group": "9_delete"
        },
        {
          "command": "agentRules.deleteAllRuleFormatFiles",
          "when": "view == agentRules.rulesView && viewItem =~ /logicalRule/",
          "group": "9_delete"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentRules.deleteRuleFile",
        "key": "delete",
        "when": "view == agentRules.rulesView && viewItem =~ /ruleFile/"
      },
      {
        "command": "agentRules.deleteAllRuleFormatFiles",
        "key": "delete",
        "when": "view == agentRules.rulesView && viewItem =~ /logicalRule/"
      }
    ],
    "configuration": {
      "title": "Agent Rules",
      "properties": {
        "agentRules.agent": {
          "type": "string",
          "enum": [
            "",
            "cursor",
            "windsurf",
            "kiro",
            "antigravity",
            "augment",
            "claude-code"
          ],
          "enumItemLabels": [
            "(none)",
            "Cursor",
            "Windsurf",
            "Kiro",
            "Antigravity",
            "Augment",
            "Claude Code"
          ],
          "default": "",
          "description": "The AI agent you use. Determines which rule formats are considered readable and where new rules are written."
        },
        "agentRules.writeFormat": {
          "type": "string",
          "enum": [
            "",
            "cursor",
            "windsurf",
            "kiro",
            "antigravity",
            "augment",
            "claude-code",
            "claude-md",
            "agents-md"
          ],
          "enumItemLabels": [
            "(agent default)",
            "Cursor (.cursor/rules/)",
            "Windsurf (.windsurf/rules/)",
            "Kiro (.kiro/steering/)",
            "Antigravity (.agents/rules/)",
            "Augment (.augment/rules/)",
            "Claude Code (.claude/rules/)",
            "CLAUDE.md",
            "AGENTS.md"
          ],
          "default": "",
          "description": "Override the format used when writing new rules. Must be a format readable by the selected agent. If empty or invalid, the agent's default format is used."
        },
        "agentRules.detectDivergence": {
          "type": "boolean",
          "default": true,
          "description": "Show a warning badge on rules that have diverged content across formats. Disable to suppress divergence warnings."
        },
        "agentRules.lint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable rule quality checks (empty body, missing description, oversized rules)."
        },
        "agentRules.lint.maxRuleTokens": {
          "type": "number",
          "default": 2000,
          "description": "Warn when a single rule body exceeds this estimated token count."
        },
        "agentRules.coverage.contextWindowTokens": {
          "type": "number",
          "default": 128000,
          "description": "Context window size (in tokens) used for coverage analysis severity thresholds."
        },
        "agentRules.autoConfigureMcp": {
          "type": "boolean",
          "default": false,
          "description": "Automatically register the MCP tool when switching to an agent that supports it."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "minimatch": "^10.2.5",
    "yaml": "^2.8.3"
  }
}
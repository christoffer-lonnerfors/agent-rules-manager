{
  "name": "agent-rules-manager",
  "displayName": "Agent Rules Manager",
  "description": "Manage, compare, and sync AI agent rule files across Cursor, Windsurf, Kiro, Antigravity, Augment, and Claude Code formats.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "christoffer-lonnerfors",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/christoffer-lonnerfors/agent-rules-manager"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "ai",
    "rules",
    "agent",
    "ai-rules",
    "ai-agent",
    "cursor",
    "windsurf",
    "kiro",
    "antigravity",
    "augment",
    "claude",
    "claude-code",
    "cursorrules",
    "windsurfrules",
    "AGENTS.md",
    "CLAUDE.md",
    "mdc",
    "lint",
    "linter",
    "sync",
    "coverage",
    "tokens",
    "context-window",
    "copilot",
    "coding-agent",
    "frontmatter",
    "divergence"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "agentRules.rescan",
        "title": "Agent Rules: Refresh Rules",
        "icon": "$(refresh)"
      },
      {
        "command": "agentRules.openRule",
        "title": "Agent Rules: Open Rule File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agentRules.compareFormats",
        "title": "Compare Formats…",
        "icon": "$(diff)"
      },
      {
        "command": "agentRules.alignFormats",
        "title": "Align Formats…",
        "icon": "$(sync)"
      },
      {
        "command": "agentRules.setAgent",
        "title": "Agent Rules: Select Agent",
        "icon": "$(edit)"
      },
      {
        "command": "agentRules.syncAll",
        "title": "Agent Rules: Sync All Diverged",
        "icon": "$(sync)"
      },
      {
        "command": "agentRules.addAllMissing",
        "title": "Agent Rules: Add All Missing",
        "icon": "$(add)"
      },
      {
        "command": "agentRules.addMissingRule",
        "title": "Add Missing Rule",
        "icon": "$(add)"
      },
      {
        "command": "agentRules.addRule",
        "title": "Agent Rules: Add Rule",
        "icon": "$(new-file)"
      },
      {
        "command": "agentRules.showCoverage",
        "title": "Agent Rules: Show Coverage Analysis",
        "icon": "$(graph)"
      },
      {
        "command": "agentRules.filterRules",
        "title": "Agent Rules: Filter Rules",
        "icon": "$(search)"
      },
      {
        "command": "agentRules.clearFilter",
        "title": "Agent Rules: Clear Filter",
        "icon": "$(close)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentRules",
          "title": "Agent Rules",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "agentRules": [
        {
          "id": "agentRules.rulesView",
          "name": "Rules",
          "icon": "$(list-unordered)",
          "contextualTitle": "Agent Rules"
        },
        {
          "id": "agentRules.actionsView",
          "type": "webview",
          "name": "Actions",
          "icon": "$(tools)",
          "contextualTitle": "Agent Rules"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "agentRules.addRule",
          "when": "view == agentRules.rulesView",
          "group": "navigation@1"
        },
        {
          "command": "agentRules.filterRules",
          "when": "view == agentRules.rulesView",
          "group": "navigation@2"
        },
        {
          "command": "agentRules.rescan",
          "when": "view == agentRules.rulesView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "agentRules.compareFormats",
          "when": "view == agentRules.rulesView && viewItem =~ /logicalRule.*diverged/",
          "group": "inline"
        },
        {
          "command": "agentRules.alignFormats",
          "when": "view == agentRules.rulesView && viewItem =~ /logicalRule.*diverged/",
          "group": "inline"
        },
        {
          "command": "agentRules.compareFormats",
          "when": "view == agentRules.rulesView && viewItem =~ /logicalRule.*diverged/",
          "group": "1_compare"
        },
        {
          "command": "agentRules.alignFormats",
          "when": "view == agentRules.rulesView && viewItem =~ /logicalRule.*diverged/",
          "group": "2_align"
        },
        {
          "command": "agentRules.addMissingRule",
          "when": "view == agentRules.rulesView && viewItem =~ /logicalRule.*missing/",
          "group": "inline"
        },
        {
          "command": "agentRules.addMissingRule",
          "when": "view == agentRules.rulesView && viewItem =~ /logicalRule.*missing/",
          "group": "1_add"
        }
      ]
    },
    "configuration": {
      "title": "Agent Rules",
      "properties": {
        "agentRules.agent": {
          "type": "string",
          "enum": [
            "",
            "cursor",
            "windsurf",
            "kiro",
            "antigravity",
            "augment",
            "claude-code"
          ],
          "enumItemLabels": [
            "(none)",
            "Cursor",
            "Windsurf",
            "Kiro",
            "Antigravity",
            "Augment",
            "Claude Code"
          ],
          "default": "",
          "description": "The AI agent you use. Determines which rule formats are considered readable and where new rules are written."
        },
        "agentRules.writeFormat": {
          "type": "string",
          "enum": [
            "",
            "cursor",
            "windsurf",
            "kiro",
            "antigravity",
            "augment",
            "claude-code",
            "claude-md",
            "agents-md"
          ],
          "enumItemLabels": [
            "(agent default)",
            "Cursor (.cursor/rules/)",
            "Windsurf (.windsurf/rules/)",
            "Kiro (.kiro/steering/)",
            "Antigravity (.agents/rules/)",
            "Augment (.augment/rules/)",
            "Claude Code (.claude/rules/)",
            "CLAUDE.md",
            "AGENTS.md"
          ],
          "default": "",
          "description": "Override the format used when writing new rules. Must be a format readable by the selected agent. If empty or invalid, the agent's default format is used."
        },
        "agentRules.detectDivergence": {
          "type": "boolean",
          "default": true,
          "description": "Show a warning badge on rules that have diverged content across formats. Disable to suppress divergence warnings."
        },
        "agentRules.lint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable rule quality checks (empty body, missing description, oversized rules)."
        },
        "agentRules.lint.maxRuleTokens": {
          "type": "number",
          "default": 2000,
          "description": "Warn when a single rule body exceeds this estimated token count."
        },
        "agentRules.candidatePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.md",
            "**/*.mdc",
            "**/*.mdx"
          ],
          "description": "Glob patterns for candidate rule file discovery. Files matching these patterns can be promoted to rules if referenced by an existing rule."
        },
        "agentRules.coverage.contextWindowTokens": {
          "type": "number",
          "default": 128000,
          "description": "Context window size (in tokens) used for coverage analysis severity thresholds."
        },
        "agentRules.candidateExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/.git/**"
          ],
          "description": "Glob patterns to exclude from candidate discovery."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "minimatch": "^10.2.5",
    "yaml": "^2.8.3"
  }
}

{
  "name": "agent-rules-manager",
  "displayName": "Agent Rules Manager",
  "description": "Manage, compare, and sync AI agent rule files across Cursor, Windsurf, Kiro, Antigravity, Augment, and Claude Code formats.",
  "version": "0.0.1",
  "license": "MIT",
  "publisher": "ai-rules",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "rules",
    "cursor",
    "windsurf",
    "claude"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "agentRules.scan",
        "title": "Agent Rules: Scan Workspace",
        "icon": "$(search)"
      },
      {
        "command": "agentRules.rescan",
        "title": "Agent Rules: Re-scan Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "agentRules.openRule",
        "title": "Agent Rules: Open Rule File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "agentRules.compareFormats",
        "title": "Compare Formats…",
        "icon": "$(diff)"
      },
      {
        "command": "agentRules.alignFormats",
        "title": "Align Formats…",
        "icon": "$(sync)"
      },
      {
        "command": "agentRules.setPrimaryFormat",
        "title": "Agent Rules: Set Primary Format",
        "icon": "$(edit)"
      },
      {
        "command": "agentRules.syncAll",
        "title": "Agent Rules: Sync All Diverged",
        "icon": "$(sync)"
      },
      {
        "command": "agentRules.addAllMissing",
        "title": "Agent Rules: Add All Missing",
        "icon": "$(add)"
      },
      {
        "command": "agentRules.addMissingRule",
        "title": "Add to Primary Format",
        "icon": "$(add)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentRules",
          "title": "Agent Rules",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "agentRules": [
        {
          "id": "agentRules.rulesView",
          "name": "Rules",
          "icon": "$(list-unordered)",
          "contextualTitle": "Agent Rules"
        },
        {
          "id": "agentRules.actionsView",
          "name": "Actions",
          "icon": "$(tools)",
          "contextualTitle": "Agent Rules"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "agentRules.scan",
          "when": "view == agentRules.rulesView",
          "group": "navigation"
        },
        {
          "command": "agentRules.rescan",
          "when": "view == agentRules.rulesView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "agentRules.compareFormats",
          "when": "view == agentRules.rulesView && viewItem == logicalRule.diverged",
          "group": "inline"
        },
        {
          "command": "agentRules.alignFormats",
          "when": "view == agentRules.rulesView && viewItem == logicalRule.diverged",
          "group": "inline"
        },
        {
          "command": "agentRules.compareFormats",
          "when": "view == agentRules.rulesView && viewItem == logicalRule.diverged",
          "group": "1_compare"
        },
        {
          "command": "agentRules.alignFormats",
          "when": "view == agentRules.rulesView && viewItem == logicalRule.diverged",
          "group": "2_align"
        },
        {
          "command": "agentRules.addMissingRule",
          "when": "view == agentRules.rulesView && viewItem == logicalRule.missing",
          "group": "inline"
        },
        {
          "command": "agentRules.addMissingRule",
          "when": "view == agentRules.rulesView && viewItem == logicalRule.missing",
          "group": "1_add"
        },
        {
          "command": "agentRules.setPrimaryFormat",
          "when": "view == agentRules.actionsView && viewItem == primaryFormat",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Agent Rules",
      "properties": {
        "agentRules.primaryFormat": {
          "type": "string",
          "enum": [
            "",
            "cursor",
            "windsurf",
            "kiro",
            "antigravity",
            "augment",
            "claude-code",
            "agents-md"
          ],
          "enumItemLabels": [
            "(none)",
            "Cursor",
            "Windsurf",
            "Kiro",
            "Antigravity",
            "Augment",
            "Claude Code",
            "AGENTS.md"
          ],
          "default": "",
          "description": "Primary AI agent format. When set, this format is suggested as the source of truth when aligning diverged rules."
        },
        "agentRules.detectDivergence": {
          "type": "boolean",
          "default": true,
          "description": "Show a warning badge on rules that have diverged content across formats. Disable to suppress divergence warnings."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.0",
    "mocha": "^11.7.5",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  }
}